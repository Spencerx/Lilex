---
import Layout from "../layouts/Layout.astro";
import LayoutBlock from "../components/LayoutBlock.astro";
import Typography from "../components/Typography.astro";
import Link from "../components/Link.astro";
---

<Layout title="Page not found — Lilex" noindex>
	<LayoutBlock theme="light" name="notFound">
		<div class="notFound">
			<Typography as="h1" variant="heading-l">404</Typography>
			<Typography color="secondary">Page not found</Typography>
			<Typography>
				<Link href="/">Go to home page</Link>
			</Typography>
		</div>
	</LayoutBlock>
</Layout>

<style lang="scss">
	.notFound {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-m);
		min-height: 100vh;
	}
</style>
